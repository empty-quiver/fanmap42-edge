{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fanmap42-hottiles",
  "compatibility_date": "2026-08-08",
  "workers_dev": false,
  "assets": {
    "directory": "./.generated/hottiles/production",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": false
  },
  "routes": [
    { "pattern": "hottiles.fanmap42.com", "custom_domain": true }
  ]
}
