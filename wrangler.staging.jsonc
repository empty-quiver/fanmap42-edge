{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fanmap42-site-staging",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "workers_dev": true,
  "assets": {
    "directory": "./.generated/site/staging",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": false
  },
  "routes": [
    { "pattern": "staging.fanmap42.com", "custom_domain": true }
  ],
  "vars": {
    "ACTIVE_RELEASE": "b42.20-steam24574865-pzmap53b73b8-fma485d32-r1",
    "EXPECTED_MANIFEST_SHA256": "e9a39b6407a23b6e2a69a4d1330c4c1bec86c013415d930b6bfe5840c8f60674",
    "CANONICAL_HOST": "staging.fanmap42.com",
    "DIRECT_TILE_ORIGIN": "https://tiles-staging.fanmap42.com",
    "READINESS_CACHE_SECONDS": "86400",
    "NEGATIVE_METADATA_CACHE_SECONDS": "300"
  },
  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "fanmap42" }
  ],
  "analytics_engine_datasets": [
    { "binding": "CACHE_METRICS", "dataset": "fanmap42_cache_staging" }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  }
}
