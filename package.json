{
  "name": "fanmap42-edge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:hottiles": "node scripts/build-hottiles.mjs",
    "build:site": "node scripts/build-site.mjs",
    "check": "npm run typecheck && npm test",
    "dev": "wrangler dev --config wrangler.jsonc",
    "test": "vitest run && node --test scripts/*.node-test.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260810.1",
    "@types/node": "^24.2.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  }
}
