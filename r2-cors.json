{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://fanmap42.com",
          "https://www.fanmap42.com"
        ],
        "methods": ["GET", "HEAD"],
        "headers": ["If-Modified-Since", "If-None-Match", "Range"]
      },
      "exposeHeaders": [
        "Accept-Ranges",
        "Cache-Control",
        "Content-Length",
        "Content-Range",
        "Content-Type",
        "ETag"
      ],
      "maxAgeSeconds": 86400
    }
  ]
}
